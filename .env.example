# SPIDY CRYPTO Environment Configuration

# Telegram Configuration (Get from @BotFather and @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delta Exchange India URLs (Defaults to live India exchange)
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange

# Risk & Account Settings (₹3,000 Margin @ 6x Leverage -> ₹18,000 Position)
ACCOUNT_EQUITY=3000.0
MAX_RISK_PCT=1.5
MAX_ALLOWED_MARGIN=3000.0
DEFAULT_LEVERAGE=6
MAX_DAILY_LOSS=500.0
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_SECONDS=300
